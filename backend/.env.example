# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Database ───────────────────────────────────────────────────────────────
# Host port 5433 (not 5432) so this project never collides with any other
# Postgres already running on the machine. Container port stays 5432.
#
# WARNING: this machine has a machine-level DATABASE_URL set (pointing at an
# unrelated `bank_reviews` database, with an incompatible `postgresql+psycopg2`
# scheme). OS environment variables take precedence over .env, so Prisma will
# fail with "URL must start with postgresql://" unless DATABASE_URL is cleared
# for the process. See scripts/run-prisma.ps1, which does this for you.
DATABASE_URL=postgresql://addis:addis_dev_password@localhost:5433/addis_one?schema=public

# ── Redis ───────────────────────────────────────────────────────────────────
# Host port 6380 for the same reason.
REDIS_URL=redis://localhost:6380

# ── Auth ────────────────────────────────────────────────────────────────────
# MUST be overridden in every non-local environment.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-32-chars-min"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-32-chars-min"
JWT_ACCESS_TTL=900          # 15 minutes
JWT_REFRESH_TTL=2592000     # 30 days
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Development only: prints the OTP to the server console instead of sending an
# SMS. MUST be false in production — OtpService throws rather than issuing a
# code when this is off and no SMS provider is wired.
OTP_DEV_ECHO=true

# Temporary fixed-credential test login (until SMS approved). TEST mode is ON
# by default here: POST+GET /auth/password-login accepts passenger/test123 and
# staff/test123. Unlike DEV_STAFF_LOGIN this IS allowed in production - that is
# its purpose (field-test without SMS). DELETE these vars + TestLoginService,
# TestLoginGuard and the password-login routes once OTP delivery is live.
# Set TEST_LOGIN_ENABLED=false to turn it off without deleting the code.
TEST_LOGIN_ENABLED=true
TEST_PASSENGER_USERNAME=passenger
TEST_PASSENGER_PASSWORD=test123
TEST_STAFF_USERNAME=staff
TEST_STAFF_PASSWORD=test123
TEST_PASSENGER_PHONE=+251911000100
TEST_STAFF_PHONE=+251911000009

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ── QR signing (I4) ─────────────────────────────────────────────────────────
# Ed25519. Generate a real keypair in production; never reuse these.
# Generate with: openssl genpkey -algorithm ed25519 -out qr_private.pem
QR_SIGNING_KEY_ID=dev-key-1
QR_PRIVATE_KEY_BASE64=""

# ── Payment providers ───────────────────────────────────────────────────────
PAYMENT_DEFAULT_PROVIDER=MOCK
# Real sandbox credentials are not committed. Configure via your provider's
# dashboard and inject through your secret manager.
TELEBIRR_APP_KEY=""
TELEBIRR_APP_SECRET=""
CBE_BIRR_MERCHANT_ID=""
CBE_BIRR_API_KEY=""

# ── Fraud / rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_API_PER_MINUTE=120
MAX_VALIDATIONS_PER_MINUTE_PER_DEVICE=20

# ── Offline sync ────────────────────────────────────────────────────────────
OFFLINE_MAX_QUEUE_SIZE=5000
OFFLINE_VALIDATION_TTL_DAYS=7
