# Production Environment Variables
# 
# Copy this to .env.prod and fill in the values.
# NEVER commit this file with real secrets.

# Core
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database (managed PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example providers:
#   Railway: postgresql://postgres:xxx@containers-us-west-xxx.railway.app:5432/railway
#   Render:  postgresql://user:xxx@dpg-xxx.oregon-postgres.render.com:5432/dbname
#   Neon:    postgresql://user:xxx@ep-xxx.us-east-1.aws.neon.tech/dbname
#   Supabase: postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# Redis (managed Redis)
# Format: redis://[:PASSWORD@]HOST:PORT
# Example providers:
#   Railway: redis://default:xxx@containers-us-west-xxx.railway.app:6379
#   Render:  redis://:xxx@redis-xxx.oregon-redis.render.com:6379
#   Upstash: redis://:xxx@us1-xxx.upstash.io:6379
REDIS_URL=

# Auth - MUST be 32+ chars in production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# OTP - must be false in production when SMS is configured
OTP_DEV_ECHO=false

# Test login (enabled for field testing)
TEST_LOGIN_ENABLED=true
TEST_PASSENGER_USERNAME=passenger
TEST_PASSENGER_PASSWORD=test123
TEST_STAFF_USERNAME=staff
TEST_STAFF_PASSWORD=test123

# CORS - set to your app domain(s)
CORS_ORIGINS=https://your-app-domain.com

# QR Signing - generate with: openssl genpkey -algorithm ed25519 -out qr_private.pem
# Then: cat qr_private.pem | base64 -w 0
QR_SIGNING_KEY_ID=prod-key-1
QR_PRIVATE_KEY_BASE64=

# Payment providers (optional)
PAYMENT_DEFAULT_PROVIDER=MOCK
TELEBIRR_APP_KEY=
TELEBIRR_APP_SECRET=
CBE_BIRR_MERCHANT_ID=
CBE_BIRR_API_KEY=